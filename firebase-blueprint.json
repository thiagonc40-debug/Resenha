{
  "entities": {
    "Court": {
      "title": "Court",
      "description": "Represents a sports court available for booking.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "features": { "type": "array", "maxLength": 20 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "type", "price", "features", "imageUrl", "isActive"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Global application configuration and settings.",
      "type": "object",
      "properties": {
        "appName": { "type": "string", "maxLength": 100 },
        "openTime": { "type": "string", "maxLength": 10 },
        "closeTime": { "type": "string", "maxLength": 10 },
        "pixKey": { "type": "string", "maxLength": 200 },
        "pixName": { "type": "string", "maxLength": 200 }
      },
      "required": ["appName", "openTime", "closeTime", "pixKey", "pixName"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator user.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 }
      },
      "required": ["email"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "Represents a booking for a court.",
      "type": "object",
      "properties": {
        "courtId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "totalPrice": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["courtId", "date", "startTime", "endTime", "customerName", "customerPhone", "status", "totalPrice", "createdAt"]
    }
  },
  "firestore": {
    "/courts/{courtId}": {
      "schema": { "$ref": "#/entities/Court" },
      "description": "Stores all courts."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSetting" },
      "description": "Stores global app settings. Typically just a singleton document 'global'."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores admin privileges."
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "Stores all reservations."
    }
  }
}
